<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="494.0" prefWidth="693.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.GManagerrequests">
   <children>
      <TableView fx:id="mytable" layoutX="14.0" layoutY="76.0" prefHeight="200.0" prefWidth="634.0">
        <columns>
            <TableColumn fx:id="reqid" prefWidth="75.0" text="request id" />
          <TableColumn fx:id="inadv" prefWidth="75.0" text="in advance" />
          <TableColumn fx:id="inplace" prefWidth="75.0" text="in place" />
            <TableColumn fx:id="regs" prefWidth="96.79998779296875" text="regular - single " />
            <TableColumn fx:id="regm" prefWidth="119.99993896484375" text="regular - multiple " />
            <TableColumn fx:id="fullmem" minWidth="8.800048828125" prefWidth="106.39999999999998" text="full membership" />
            <TableColumn fx:id="managerid" prefWidth="75.0" text="Manager id " />
        </columns>
      </TableView>
      <Button fx:id="backbtn" layoutX="26.0" layoutY="340.0" mnemonicParsing="false" onAction="#backto" text="back" />
      <ComboBox fx:id="combobx" layoutX="339.0" layoutY="340.0" opacity="0.54" prefWidth="150.0" promptText="Request id" />
      <Label layoutX="169.0" layoutY="344.0" text="choose request id to approve">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Button fx:id="approvebtn" layoutX="321.0" layoutY="400.0" mnemonicParsing="false" onAction="#approve" style="-fx-background-color: green;" text="Approve" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Button>
      <Label fx:id="labelmsg" layoutX="337.0" layoutY="438.0" />
      <Label layoutX="270.0" layoutY="32.0" text="Change Prices Requests ">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <Button fx:id="reject" layoutX="403.0" layoutY="400.0" mnemonicParsing="false" onAction="#rejectRequest" style="-fx-background-color: red;" text="Reject" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
