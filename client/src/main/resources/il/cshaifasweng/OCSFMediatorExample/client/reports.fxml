<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="435.0" prefWidth="642.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.Reports">
   <children>
      <DatePicker fx:id="fromdate" layoutX="272.0" layoutY="138.0" />
      <Label layoutX="218.0" layoutY="142.0" prefHeight="18.0" prefWidth="40.0" text="from ">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Label layoutX="218.0" layoutY="186.0" text="until">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <DatePicker fx:id="untildate" layoutX="272.0" layoutY="182.0" />
      <Button fx:id="ordersRepbtn" layoutX="267.0" layoutY="242.0" mnemonicParsing="false" onAction="#OrderReport" text="request Orders report " />
      <Button fx:id="complaintsRepbtn" layoutX="256.0" layoutY="291.0" mnemonicParsing="false" onAction="#ComplintsReport" text="request Compliants report" />
      <Button fx:id="disabledSpotsRepbtn" layoutX="248.0" layoutY="336.0" mnemonicParsing="false" onAction="#DisabledReport" text="request disabled spots report" />
      <Label layoutX="112.0" layoutY="31.0" prefHeight="78.0" prefWidth="442.0" text="please choose a time period to request a report ">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <Button fx:id="PreparedRequestsbtn" layoutX="486.0" layoutY="389.0" mnemonicParsing="false" onAction="#gotoPreparedReports" text="see all prepared reports" />
      <Button fx:id="backbtn" layoutX="42.0" layoutY="389.0" mnemonicParsing="false" onAction="#backto" text="back" />
   </children>
</AnchorPane>
