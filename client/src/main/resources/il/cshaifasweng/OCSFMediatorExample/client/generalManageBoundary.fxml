<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.GeneralManagerController">
   <children>
      <Text fill="#1b1b1b" layoutX="181.0" layoutY="79.0" strokeType="OUTSIDE" strokeWidth="0.0" text="General's Manager workspace">
         <font>
            <Font size="19.0" />
         </font>
      </Text>
      <Button fx:id="orderReportsBtn" layoutX="244.0" layoutY="145.0" mnemonicParsing="false" onAction="#orderReports" text="Order reports" />
      <Button fx:id="confirmNewPricesBtn" layoutX="229.0" layoutY="200.0" mnemonicParsing="false" onAction="#confirmNewPrices" text="Confirm new prices" />
      <Button fx:id="showPricesBtn" layoutX="248.0" layoutY="257.0" mnemonicParsing="false" onAction="#showPrices" text="Show prices" />
      <Button fx:id="goBackBtn" layoutX="476.0" layoutY="329.0" mnemonicParsing="false" onAction="#goBack" prefHeight="36.0" prefWidth="66.0" text="Back" />
   </children>
</AnchorPane>
