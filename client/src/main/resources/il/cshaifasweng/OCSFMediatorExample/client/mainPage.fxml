<AnchorPane prefHeight="458.0" prefWidth="640.0" stylesheets="@CssStyle/MainPageStyle.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.Boundaries.MainPage">
